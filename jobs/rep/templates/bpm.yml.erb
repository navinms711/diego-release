---
processes:
- name: rep
  executable: /var/vcap/jobs/rep/bin/rep
<% if p("diego.rep.enable_cf_pcap", false) -%>
  # This is required to preserve the file capabilities of cf-pcap to allow the vcap user to capture
  # packets inside the app container without root.
  capabilities: [ "SETFCAP" ]
<% end -%>
  limits:
    open_files: 100000
  hooks:
    pre_start: /var/vcap/jobs/rep/bin/bpm-pre-start
  ephemeral_disk: true
  additional_volumes:
    - path: <%= p("diego.executor.volman.driver_paths") %>
    - path : /var/vcap/data/garden
      writable: true
    - path: <%= p("diego.rep.extra_root_fs_dir") %>
    # Do not add /var/vcap/store/rep: BPM reserves it as the job's default store directory.
    # Bind-mount the pre-warmed droplet cache disk (hot-attached in bpm-pre-start) into the
    # BPM container so rep can detect it via the rep_cache_path flag file and use it.
    - path: /var/vcap/store/rep_download_cache
      writable: true
