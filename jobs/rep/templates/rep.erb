#!/bin/bash -e

conf_dir=/var/vcap/jobs/rep/config

zone_flag=""
<% if p("diego.rep.use_azure_fault_domains") %>
set +e
  azure_fd=$(curl -f --max-time 5 --silent http://169.254.169.254/metadata/v1/InstanceInfo/FD)
  if [ 0 -eq $? ]; then
    zone_flag="-zone=z${azure_fd}"
  else
    echo "{\"timestamp\":\"$(date --rfc-3339=ns | sed 's/ /T/' | sed 's/+00:00/Z/')\",\"level\":\"info\",\"source\":\"rep\",\"message\":\"Warning: Failed to curl azure metadata endpoint for fault domain\"}"
  fi
  azure_zone=$(curl -f --max-time 5 --silent -H Metadata:true "http://169.254.169.254/metadata/instance/compute/zone?api-version=2017-12-01&format=text")
  if [ 0 -eq $? ]; then
    if [ ! -z $azure_zone ]; then
      zone_flag=""
    fi
  else
  echo "{\"timestamp\":\"$(date --rfc-3339=ns | sed 's/ /T/' | sed 's/+00:00/Z/')\",\"level\":\"info\",\"source\":\"rep\",\"message\":\"Warning: Failed to curl azure metadata endpoint for availability zone\"}"
  fi
set -e
<% end %>

# Colocated agents: monit/BOSH start order does not wait for listen-ready. Rep can exit if
# loggregator-agent (v2 API, default 3458) or Silk (23954) is not accepting yet; wait briefly
# then proceed (matches experiments on devperf opsman ~/diego-release).
echo "$(date) [rep] Waiting for loggregator-agent on port 3458..." >> /var/vcap/sys/log/rep/rep.stdout.log
for i in {1..60}; do
  if nc -z 127.0.0.1 3458 2>/dev/null; then
    echo "$(date) [rep] Loggregator is UP after ${i}s. Proceeding." >> /var/vcap/sys/log/rep/rep.stdout.log
    break
  fi
  if [ "$i" -eq 60 ]; then
    echo "$(date) [rep] WARNING: Loggregator not ready after 60s, starting rep anyway" >> /var/vcap/sys/log/rep/rep.stdout.log
  fi
  sleep 1
done

echo "$(date) [rep] Waiting for Silk Daemon on port 23954..." >> /var/vcap/sys/log/rep/rep.stdout.log
for i in {1..60}; do
  if nc -z 127.0.0.1 23954 2>/dev/null; then
    echo "$(date) [rep] Silk Daemon is UP after ${i}s. Proceeding." >> /var/vcap/sys/log/rep/rep.stdout.log
    break
  fi
  if [ "$i" -eq 60 ]; then
    echo "$(date) [rep] WARNING: Silk Daemon not ready after 60s, starting rep anyway" >> /var/vcap/sys/log/rep/rep.stdout.log
  fi
  sleep 0.5
done

exec /var/vcap/packages/rep/bin/rep \
      -config=$conf_dir/rep.json ${zone_flag}
