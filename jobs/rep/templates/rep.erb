#!/bin/bash -e

conf_dir=/var/vcap/jobs/rep/config

zone_flag=""
<% if p("diego.rep.use_azure_fault_domains") %>
set +e
  azure_fd=$(curl -f --max-time 5 --silent http://169.254.169.254/metadata/v1/InstanceInfo/FD)
  if [ 0 -eq $? ]; then
    zone_flag="-zone=z${azure_fd}"
  else
    echo "{\"timestamp\":\"$(date --rfc-3339=ns | sed 's/ /T/' | sed 's/+00:00/Z/')\",\"level\":\"info\",\"source\":\"rep\",\"message\":\"Warning: Failed to curl azure metadata endpoint for fault domain\"}"
  fi
  azure_zone=$(curl -f --max-time 5 --silent -H Metadata:true "http://169.254.169.254/metadata/instance/compute/zone?api-version=2017-12-01&format=text")
  if [ 0 -eq $? ]; then
    if [ ! -z $azure_zone ]; then
      zone_flag=""
    fi
  else
  echo "{\"timestamp\":\"$(date --rfc-3339=ns | sed 's/ /T/' | sed 's/+00:00/Z/')\",\"level\":\"info\",\"source\":\"rep\",\"message\":\"Warning: Failed to curl azure metadata endpoint for availability zone\"}"
  fi
set -e
<% end %>

# loggregator-agent (gRPC ingress, port <%= p("loggregator.v2_api_port") %>) starts concurrently
# with rep. If rep starts before the agent binds its port, the first log flush errors
# and startup diagnostics are lost; there is no Go-level retry for this path.
# Silk-daemon readiness is handled by the isTransientSilkError retry loop in main.go.
# /dev/tcp is a bash built-in — no dependency on nc or netcat.
_log_startup() { echo "$(date) [rep] $*"; }

_log_startup "Polling loggregator-agent (port <%= p("loggregator.v2_api_port") %>)..."
for _i in {1..60}; do
  if (: >/dev/tcp/127.0.0.1/<%= p("loggregator.v2_api_port") %>) 2>/dev/null; then
    _log_startup "Loggregator-agent UP after ${_i}s. Starting rep."
    break
  fi
  if [ "$_i" -eq 60 ]; then
    _log_startup "WARNING: loggregator-agent not ready after 60s, starting rep anyway."
    break
  fi
  sleep 1
done
unset -f _log_startup
unset _i

exec /var/vcap/packages/rep/bin/rep \
      -config=$conf_dir/rep.json ${zone_flag}
